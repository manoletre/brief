{
  "manifest_version": 3,
  "name": "brief",
  "description": "Tells your daily brief what you read and worked on in your browser. Everything stays on this Mac.",
  "version": "1.0",
  "icons": { "128": "icon.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "128": "icon.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["tabs", "storage", "idle", "alarms"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
